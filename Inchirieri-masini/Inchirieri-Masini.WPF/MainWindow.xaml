<Window x:Class="InchirieriMasini.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Detalii Închiriere"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#D6EAF8"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

        <!-- ========================= -->
        <!--        CULORI GLOBALE     -->
        <!-- ========================= -->
        <Color x:Key="PrimaryColor">#5DADE2</Color>
        <Color x:Key="PrimaryDark">#1B4F72</Color>
        <Color x:Key="PrimaryLight">#D6EAF8</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>

        <!-- ========================= -->
        <!--        LABEL STYLE         -->
        <!-- ========================= -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- ========================= -->
        <!--        TEXTBOX STYLE       -->
        <!-- ========================= -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ========================= -->
        <!--        BUTTON STYLE        -->
        <!-- ========================= -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================= -->
        <!--     RADIOBUTTON STYLE     -->
        <!-- ========================= -->
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- ========================= -->
        <!--      CHECKBOX STYLE       -->
        <!-- ========================= -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- ========================= -->
        <!--      DATAGRID STYLE       -->
        <!-- ========================= -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F2F2F2"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

    </Window.Resources>



    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="23*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Meniu -->
            <RowDefinition/>
            <!-- Conținut -->
        </Grid.RowDefinitions>


        <!-- MENIU -->
        <Menu Grid.Row="0" Background="#5DADE2" Foreground="Black" FontSize="16" Grid.ColumnSpan="2">
            <MenuItem Header="Fișier">
                <MenuItem Header="Ieșire" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="Client">
                <MenuItem Header="Adaugă Client" Click="OnMenuAddClient"/>
                <MenuItem Header="Caută Client" Click="OnMenuSearchClient"/>
            </MenuItem>
            <MenuItem Header="Ajutor">
                <MenuItem Header="Despre" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ========================= -->
        <!--      FORMULAR CLIENT      -->
        <!-- ========================= -->
        <ScrollViewer Grid.Row="1"
              Grid.ColumnSpan="2"
              Margin="0,23,0,0"
              VerticalScrollBarVisibility="Auto">
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <!--Masini-->
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ScrollViewerFormular" Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="StackPanelTabel" Grid.Column="1" Grid.Row="0" Margin="20">


                    <Border Background="#AED6F1"
                    CornerRadius="15"
                    Padding="25"
                    Width="380"
                    Margin="0 20"
                    BorderBrush="#5DADE2"
                    BorderThickness="2">

                        <StackPanel>

                            <Label Content="Adaugă Client Nou"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#154360"
                           Margin="0 0 0 15"/>

                            <!-- NUME -->
                            <Label x:Name="LblNume" Content="Nume"/>
                            <TextBox x:Name="TxtNume"/>
                            <TextBlock x:Name="ErrNume" Foreground="Red" Visibility="Collapsed"/>

                            <!-- PRENUME -->
                            <Label x:Name="LblPrenume" Content="Prenume"/>
                            <TextBox x:Name="TxtPrenume"/>
                            <TextBlock x:Name="ErrPrenume" Foreground="Red" Visibility="Collapsed"/>

                            <!-- CNP -->
                            <Label x:Name="LblCNP" Content="CNP"/>
                            <TextBox x:Name="TxtCNP"/>
                            <TextBlock x:Name="ErrCNP" Foreground="Red" Visibility="Collapsed"/>

                            <Label Content="Data nașterii"/>
                            <DatePicker x:Name="DtpDataNasterii"
                                        SelectedDateFormat="Short"
                                        DisplayDateEnd="{x:Static sys:DateTime.Today}"/>

                            <!-- GEN -->
                            <Label Content="Gen"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbFeminin" Content="Feminin" Margin="5"/>
                                <RadioButton x:Name="RbMasculin" Content="Masculin" Margin="5"/>



                            </StackPanel>



                            <!-- NEWSLETTER -->
                            <CheckBox x:Name="CbNewsletter" Content="Abonare la newsletter" Margin="5"/>


                            <Separator Margin="0 10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Adaugă" Click="OnAddClient"/>
                                <Button Content="Reset" Background="#3498DB" Click="OnResetClient"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========================= -->
            <!--        TABEL CLIENTI      -->
            <!-- ========================= -->
            <StackPanel Grid.Column="1" Margin="20">

                <Label Content="Lista Clienților"
               FontSize="22"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Foreground="#154360"
               Margin="0 0 0 15"/>
                
                

                <!-- CĂUTARE CLIENT -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <TextBox x:Name="TxtCauta"
                 Width="200"
                 Height="30"
                 Margin="0 0 10 0"/>
                    <Button Content="Caută" Width="80" Click="OnCautaClient"/>
                    <Button Content="Reset" Width="80" Background="#3498DB" Click="OnResetCautare"/>
                </StackPanel>

                <ComboBox x:Name="CmbSelecteazaClient"
                            Width="200"
                            DisplayMemberPath="Nume"
                            SelectionChanged="CmbSelecteazaClient_SelectionChanged"/>

                <Label Content="Filtrează după gen:" Margin="0 10 0 5"/>

                <ListBox x:Name="LstFiltruGen"
                        SelectionMode="Single"
                        Height="60"
                        SelectionChanged="LstFiltruGen_SelectionChanged">
                    <ListBoxItem Content="Toți"/>
                    <ListBoxItem Content="Feminin"/>
                    <ListBoxItem Content="Masculin"/>
                </ListBox>




                <DataGrid x:Name="DataGridClienti"
                          AutoGenerateColumns="False"
                          Background="White"
                          Foreground="Black"
                          FontSize="14"
                          Margin="0 10"
                          Height="350"
                          Width="420"
                          IsReadOnly="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
                        <DataGridTextColumn Header="Prenume" Binding="{Binding Prenume}" Width="*"/>
                        <DataGridTextColumn Header="CNP" Binding="{Binding CNP}" Width="110"/>

                        <!-- GEN -->
                        <DataGridTextColumn Header="Gen" Binding="{Binding Gen}" Width="*"/>

                        <!-- ABONAT -->
                        <DataGridTextColumn Header="Abonat" Binding="{Binding Abonat}" Width="*"/>
                    </DataGrid.Columns>

                </DataGrid>

                <!-- BUTON MODIFICĂ CLIENT - lab 9--> 
                <Button Content="Modifică client"
                        Width="150"
                        Click="OnModificaClient"/>
                <Button Content="Actualizează"
                        Width="150"
                        Click="OnActualizeazaClient"/>





            </StackPanel>

            <GroupBox Header="Gestionare Mașini"
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="20"
                      FontSize="22"
                      FontWeight="Bold">

                <StackPanel>

                    <!-- Formular Mașini -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">

                        <StackPanel Margin="0 0 20 0">
                            <Label Content="Marcă"/>
                            <TextBox Width="120"
                         Text="{Binding MasinaCurenta.Marca, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <Label Content="Model"/>
                            <TextBox Width="120"
                         Text="{Binding MasinaCurenta.Model, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <Label Content="An fabricație"/>
                            <TextBox Width="80"
                         Text="{Binding MasinaCurenta.AnFabricatie, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <Label Content="Nr. înmatriculare"/>
                            <TextBox Width="120"
                         Text="{Binding MasinaCurenta.NumarInmatriculare, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel>
                            <Label Content="Disponibilă"/>
                            <CheckBox IsChecked="{Binding MasinaCurenta.Disponibila, Mode=TwoWay}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Butoane CRUD -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <Button Content="Adaugă" Width="90" Margin="0 0 10 0"
                                    Click="BtnAdaugaMasina_Click"/>
                        <Button Content="Modifică" Width="90" Margin="0 0 10 0"
                                Click="BtnModificaMasina_Click"/>
                        <Button Content="Actualizează" Width="125" Margin="0 0 10 0"
                                Click="BtnActualizeazaMasina_Click"/>
                        <Button Content="Șterge" Width="80"
                                Click="BtnStergeMasina_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="DataGridMasini"
                  ItemsSource="{Binding Masini}"
                  SelectedItem="{Binding MasinaCurenta, Mode=TwoWay}"
                  AutoGenerateColumns="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Marcă" Binding="{Binding Marca}"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
                            <DataGridTextColumn Header="An" Binding="{Binding AnFabricatie}"/>
                            <DataGridTextColumn Header="Nr. înmatriculare" Binding="{Binding NumarInmatriculare}"/>
                            <DataGridCheckBoxColumn Header="Disponibilă" Binding="{Binding Disponibila}"/>
                        </DataGrid.Columns>

                    </DataGrid>

                    <Label Content="{Binding ElementName=DataGridMasini,
                                 Path=Items.Count,
                                 StringFormat='Număr mașini: {0}'}"
               FontWeight="Bold"
               Margin="0 10 0 0"/>

                </StackPanel>
            </GroupBox>


        </Grid>
        </ScrollViewer>
    </Grid>

</Window>